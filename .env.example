# OpenWeather API key — get one free at https://home.openweathermap.org/api_keys
# Note: VITE_* variables are inlined into the client bundle and are publicly visible.
VITE_OPENWEATHER_API_KEY=your_api_key_here

# Optional: canonical site URL used for SEO tags (defaults to the Vercel production URL)
# VITE_SITE_URL=https://react-acko-weather-app.vercel.app
